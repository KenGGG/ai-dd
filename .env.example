PORT=3871
HOST=0.0.0.0

# Python environment used by server/python.ts when calling notebooklm-py and A股公告 scripts.
AIDDA_CONDA_ENV=openclaw

# Runtime data directory. Defaults to data.
AIDDA_DATA_DIR=data

# SQLite database path. Defaults to data/aidda.sqlite.
AIDDA_DB_PATH=data/aidda.sqlite

# Maximum Python worker stdout/stderr buffer in MiB. Defaults to 50.
AIDDA_PYTHON_MAX_BUFFER_MB=50
